# ==========================================
# 生产环境配置示例
# ==========================================
# 使用说明：
# 1. 复制此文件并重命名为 .env.production
# 2. 填写实际的配置值
# 3. 不要将 .env.production 提交到 Git

# ==========================================
# 数据库配置
# ==========================================
DATABASE_URL=file:/app/data/production.db

# ==========================================
# Clerk 认证配置
# ==========================================
# 从 Clerk Dashboard 获取这些密钥
# https://dashboard.clerk.com/

# 公开密钥（前端可见）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 密钥（服务端使用，需保密）
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 登录页面路径
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# 登录后跳转路径
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ==========================================
# 应用配置
# ==========================================
NODE_ENV=production
PORT=3100
NEXT_TELEMETRY_DISABLED=1

# 应用域名（用于生成绝对路径）
NEXT_PUBLIC_APP_URL=http://space.ltbot.top

# ==========================================
# AI API 配置
# ==========================================
# DeepSeek API 配置（用于故事生成）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API 配置（可选）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ==========================================
# 手机号登录注册（短信认证）
# ==========================================
# 阿里云号码认证服务（Dypnsapi）AccessKey，只存服务端
ALIBABA_ACCESS_KEY_ID=xxx
ALIBABA_ACCESS_KEY_SECRET=xxx
# 阿里云控制台获取的系统赠送签名与模板编号
SMS_SIGN_NAME=xxx
SMS_TEMPLATE_CODE=xxx
# 生产环境必须为 false，使用真实阿里云短信；本地开发可不配置，非生产默认 mock 验证码 123456
SMS_MOCK_MODE=false
# 验证码凭证签名密钥（生产必须设置强随机值）
AUTH_VERIFY_SECRET=xxx

# 密码传输加密（RSA-OAEP），生成命令：node scripts/generate-password-key.mjs
# 私钥只存服务端；未配置时非生产环境允许明文，生产环境必须配置
AUTH_PASSWORD_PRIVATE_KEY_B64=xxx
NEXT_PUBLIC_AUTH_PASSWORD_PUBLIC_KEY_B64=xxx

# ==========================================
# 其他第三方服务配置
# ==========================================
# 根据需要添加其他配置

